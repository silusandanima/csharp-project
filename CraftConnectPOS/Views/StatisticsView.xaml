<UserControl x:Class="CraftConnectPOS.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CraftConnectPOS.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

       
        <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:MetricCard Margin="0,0,12,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

           
            <Border Style="{StaticResource GlassCard}" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title + Subtitle -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Monthly Revenue Progress"
                                   FontFamily="{StaticResource SerifFont}" FontSize="23"
                                   Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold"/>
                        <TextBlock Text="Last 6 months · Hover bar to highlight"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>

                    
                    <Border Grid.Row="1" Height="1" Background="#E0EDE6" Margin="0,0,0,16"/>

                   
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Bars}" VerticalAlignment="Bottom">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                   
                                    <TextBlock Text="{Binding Amount}" FontSize="10"
                                               Foreground="{StaticResource DeepGreenBrush}"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                                   
                                    <Border Width="48" Height="{Binding Height}" CornerRadius="6,6,0,0" ToolTip="{Binding Amount}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                <GradientStop Color="#1B5E20" Offset="0"/>
                                                <GradientStop Color="#4CAF50" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0.82"/>
                                                
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Month}" Value="Jun">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#4CAF50" Opacity="0.6"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#4CAF50" Opacity="0.5"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    
                                    <TextBlock Text="{Binding Month}" Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    
                                                    <DataTrigger Binding="{Binding Month}" Value="Jun">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource DeepGreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            
            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                <StackPanel>
                    
                    <TextBlock Text="Revenue Breakdown"
                               FontFamily="{StaticResource SerifFont}" FontSize="23"
                               Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold"/>
                    <TextBlock Text="By product category"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,16"/>

                    <ItemsControl ItemsSource="{Binding Breakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,2">
                                    <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#F7FAF7" Offset="0"/>
                                                <GradientStop Color="#F0F7F2" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            
                                            <Border CornerRadius="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Title}" Value="Pottery">
                                                                <Setter Property="Background" Value="#1565C0"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Title}" Value="Textiles">
                                                                <Setter Property="Background" Value="#6A1B9A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Title}" Value="Wood Crafts">
                                                                <Setter Property="Background" Value="#E65100"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource DeepGreenBrush}"
                                                           FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="12" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            
                                            <Border Grid.Column="2" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#C8E6C9" Offset="0"/>
                                                        <GradientStop Color="#DFF1E6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Title}" Value="Pottery">
                                                                <Setter Property="Background" Value="#BBDEFB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Title}" Value="Textiles">
                                                                <Setter Property="Background" Value="#E1BEE7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Title}" Value="Wood Crafts">
                                                                <Setter Property="Background" Value="#FFE0B2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Note}" FontWeight="SemiBold" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Title}" Value="Pottery">
                                                                    <Setter Property="Foreground" Value="#1565C0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Title}" Value="Textiles">
                                                                    <Setter Property="Foreground" Value="#6A1B9A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Title}" Value="Wood Crafts">
                                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    
                                    <ProgressBar Minimum="0" Maximum="100" Height="5" Margin="20,0,0,8"
                                                 Background="#E2EDE7" BorderThickness="0">
                                        <ProgressBar.Foreground>
                                            <SolidColorBrush Color="#3A8C4E"/>
                                        </ProgressBar.Foreground>
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Value" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Title}" Value="Home Decor">
                                                        <Setter Property="Value" Value="42"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Title}" Value="Pottery">
                                                        <Setter Property="Value" Value="28"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Title}" Value="Textiles">
                                                        <Setter Property="Value" Value="19"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Title}" Value="Wood Crafts">
                                                        <Setter Property="Value" Value="11"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>

                                    
                                    <Border Height="1" Background="#EBF3EE" Margin="0,0,0,6"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

