<UserControl x:Class="CraftConnectPOS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CraftConnectPOS.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,22">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:MetricCard Margin="0,0,12,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource GlassCard}" Margin="0,0,22,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Recent Customer Orders" FontFamily="{StaticResource SerifFont}"
                               FontSize="24" Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold" Margin="0,0,0,18"/>
                    <DataGrid ItemsSource="{Binding RecentOrders}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="110"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="190"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="Low Stock Materials" FontFamily="{StaticResource SerifFont}" FontSize="24"
                               Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold" Margin="0,0,0,18"/>
                    <ItemsControl ItemsSource="{Binding LowStockItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7FAF7" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="14" Height="14" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Margin="14,0,0,0">
                                            <TextBlock Text="{Binding Material}" Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold" FontSize="15"/>
                                            <TextBlock Text="{Binding Quantity}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

