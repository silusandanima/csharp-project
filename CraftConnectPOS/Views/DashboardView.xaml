<UserControl x:Class="CraftConnectPOS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CraftConnectPOS.Controls">
    <UserControl.Resources>

        <!-- DataGrid Row hover style -->
        <Style x:Key="DashHoverRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF4EE"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D0EDD8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid column header style -->
        <Style x:Key="DashHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F7F2"/>
            <Setter Property="Foreground" Value="#2E5D3A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#CAD7C8"/>
        </Style>

    </UserControl.Resources>