<UserControl x:Class="CraftConnectPOS.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CraftConnectPOS.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:MetricCard Margin="0,0,12,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.65*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="Customer Order" FontFamily="{StaticResource SerifFont}" FontSize="22"
                               Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold" Margin="0,0,0,18"/>
                    <TextBlock Text="Order ID" FontWeight="SemiBold"/>
                    <TextBox Text="ORD-8421" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Customer name" FontWeight="SemiBold"/>
                    <TextBox Text="Jane Perera" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Product" FontWeight="SemiBold"/>
                    <TextBox Text="Batik wall hanging" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Quantity" FontWeight="SemiBold"/>
                    <TextBox Text="1" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Status" FontWeight="SemiBold"/>
                    <ComboBox SelectedIndex="1" Margin="0,5,0,12" Padding="10,8">
                        <ComboBoxItem Content="Pending"/>
                        <ComboBoxItem Content="Processing"/>
                        <ComboBoxItem Content="Shipped"/>
                        <ComboBoxItem Content="Completed"/>
                    </ComboBox>
                    <TextBlock Text="Total" FontWeight="SemiBold"/>
                    <TextBox Text="Rs. 11,800" Style="{StaticResource InputBox}" Margin="0,5,0,18"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Save Order" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Orders List" FontFamily="{StaticResource SerifFont}" FontSize="22"
                               Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold" Margin="0,0,0,16"/>
                    <DataGrid ItemsSource="{Binding Orders}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding OrderId}" Width="100"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="185"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

