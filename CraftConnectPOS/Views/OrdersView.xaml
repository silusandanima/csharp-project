<UserControl x:Class="CraftConnectPOS.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CraftConnectPOS.Controls">
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,18">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:MetricCard Margin="0,0,12,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.55*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,20,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Customer Order" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>

                        <TextBlock Text="Order ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding OrderId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,5,0,10"/>

                        <TextBlock Text="Customer name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,5,0,10"/>

                        <TextBlock Text="Product" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding ProductOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedProduct}"
                                  Style="{StaticResource InputComboBox}"
                                  Margin="0,5,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding OrderStatus}"
                                          Style="{StaticResource InputComboBox}"
                                          Margin="0,5,0,0">
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Total" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding TotalText, Mode=OneWay}" Style="{StaticResource InputBox}"
                                 IsReadOnly="True" Background="#F5FAF7" Margin="0,5,0,10"/>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#C83C3C"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MinHeight="16"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,0,5,0"/>
                            <Button Grid.Column="1" Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Height="42" Margin="5,0"/>
                            <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Height="42" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Orders List" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="Add New"
                                Command="{Binding NewCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="14,7"/>
                        <TextBox Grid.Row="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}"
                                 Margin="0,10,8,0"
                                 ToolTip="Search orders"/>
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Style="{StaticResource InputComboBox}"
                                  Margin="0,10,0,0"
                                  Padding="8,6"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding OrdersView}"
                              SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              RowHeight="48"
                              ColumnHeaderHeight="46"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowStyle="{StaticResource OwnedDataGridRow}"
                              CellStyle="{StaticResource OwnedDataGridCell}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding OrderId}" Width="82"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="1.35*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="42"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="78"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=Rs. {0:N2}}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

