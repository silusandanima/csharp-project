<UserControl x:Class="CraftConnectPOS.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CraftConnectPOS.Controls">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#33464D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SerifFont}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource DeepGreenBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,18">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:MetricCard Margin="0,0,12,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="1.7*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,20,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Customer Order" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>

                        <TextBlock Text="Order ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="ORD-8421" Style="{StaticResource InputBox}" Margin="0,5,0,10"/>

                        <TextBlock Text="Customer name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="Jane Perera" Style="{StaticResource InputBox}" Margin="0,5,0,10"/>

                        <TextBlock Text="Product" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="Batik wall hanging" Style="{StaticResource InputBox}" Margin="0,5,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="1" Style="{StaticResource InputBox}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                                <ComboBox SelectedIndex="1"
                                          Height="38"
                                          Background="White"
                                          BorderBrush="#CAD7D1"
                                          BorderThickness="1"
                                          Padding="10,6"
                                          Margin="0,5,0,0">
                                    <ComboBoxItem Content="Pending"/>
                                    <ComboBoxItem Content="Processing"/>
                                    <ComboBoxItem Content="Shipped"/>
                                    <ComboBoxItem Content="Completed"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Total" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="Rs. 11,800" Style="{StaticResource InputBox}" Margin="0,5,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Save Order" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource DangerButton}" Height="42" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Orders List" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>
                    <DataGrid ItemsSource="{Binding Orders}"
                              AutoGenerateColumns="False"
                              RowHeight="48"
                              ColumnHeaderHeight="46"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding OrderId}" Width="90"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="1.05*"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="1.35*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="54"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="92"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="96"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

