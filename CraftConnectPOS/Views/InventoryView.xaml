<UserControl x:Class="CraftConnectPOS.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CraftConnectPOS.Controls">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#33464D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SerifFont}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource DeepGreenBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,18">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:MetricCard Margin="0,0,12,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="1.7*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,20,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Material Details" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>

                        <TextBlock Text="Code" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="MAT-201" Style="{StaticResource InputBox}" Margin="0,5,0,11"/>

                        <TextBlock Text="Material name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="Terracotta clay" Style="{StaticResource InputBox}" Margin="0,5,0,11"/>

                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.45*"/>
                                <ColumnDefinition Width="0.75*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="120" Style="{StaticResource InputBox}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Unit" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="kg" Style="{StaticResource InputBox}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Reorder level" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="30" Style="{StaticResource InputBox}" Margin="0,5,0,11"/>

                        <TextBlock Text="Supplier" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="Ambalangoda Clay Works" Style="{StaticResource InputBox}" Margin="0,5,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Save Changes" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Delete" Style="{StaticResource DangerButton}" Height="42" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Inventory List" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>
                    <DataGrid ItemsSource="{Binding Materials}"
                              AutoGenerateColumns="False"
                              RowHeight="48"
                              ColumnHeaderHeight="46"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="84"/>
                            <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="62"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="62"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="180"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="92"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

