<UserControl x:Class="CraftConnectPOS.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CraftConnectPOS.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:MetricCard Margin="0,0,12,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.65*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="Material Details" FontFamily="{StaticResource SerifFont}" FontSize="22"
                               Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold" Margin="0,0,0,18"/>
                    <TextBlock Text="Code" FontWeight="SemiBold"/>
                    <TextBox Text="MAT-201" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Material name" FontWeight="SemiBold"/>
                    <TextBox Text="Terracotta clay" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Quantity" FontWeight="SemiBold"/>
                    <TextBox Text="120" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Unit" FontWeight="SemiBold"/>
                    <TextBox Text="kg" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Supplier" FontWeight="SemiBold"/>
                    <TextBox Text="Ambalangoda Clay Works" Style="{StaticResource InputBox}" Margin="0,5,0,18"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Save Changes" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Delete" Style="{StaticResource DangerButton}" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Inventory List" FontFamily="{StaticResource SerifFont}" FontSize="22"
                               Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold" Margin="0,0,0,16"/>
                    <DataGrid ItemsSource="{Binding Materials}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="190"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

