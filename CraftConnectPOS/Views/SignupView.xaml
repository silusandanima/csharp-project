<UserControl x:Class="CraftConnectPOS.Views.SignupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Ellipse Width="360" Height="360" Fill="#BBDCCB" Opacity="0.42" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-155,-190,0,0"/>
        <Ellipse Width="330" Height="330" Stroke="#DDE7DA" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,190,0"/>
        <Ellipse Width="520" Height="520" Stroke="#D9D7B8" StrokeThickness="58" Opacity="0.48" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-240,-270"/>

        <Border Width="460" Style="{StaticResource GlassCard}" Padding="46" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Image Source="pack://application:,,,/Assets/Brand/CraftConnectLogo.png"
                       Width="72" Height="72" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"/>

                <TextBlock Text="Create account" FontFamily="{StaticResource SerifFont}" Foreground="{StaticResource DeepGreenBrush}"
                           FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Set up access for a new team member" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" Margin="0,4,0,22"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Login" Command="{Binding ShowLoginCommand}" Style="{StaticResource SecondaryButton}"/>
                    <Border Grid.Column="1" Background="{StaticResource PrimaryGreenBrush}" CornerRadius="20" Padding="0,10" Margin="-8,0,0,0">
                        <TextBlock Text="Sign up" Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#33464D" FontSize="12"/>
                <TextBox Text="newuser" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#33464D" FontSize="12"/>
                <PasswordBox Password="demo123" Style="{StaticResource InputPassword}" Margin="0,5,0,12"/>
                <TextBlock Text="Reconfirm password" FontWeight="SemiBold" Foreground="#33464D" FontSize="12"/>
                <PasswordBox Password="demo123" Style="{StaticResource InputPassword}" Margin="0,5,0,20"/>

                <Button Content="Create account" Command="{Binding CreateAccountCommand}" Style="{StaticResource PrimaryButton}" Padding="16,13"/>
                <Button Content="Already have an account? Sign in" Command="{Binding ShowLoginCommand}" Style="{StaticResource SecondaryButton}"
                        Margin="0,12,0,0" Padding="16,13"/>

                <TextBlock Text="WPF | MVVM | C# | .NET Framework" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
