<UserControl x:Class="CraftConnectPOS.Views.SignupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RoundedTextBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DeepGreenBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource InputPassword}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DeepGreenBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Background Shapes matching v19 mockup -->
        <Ellipse Width="360" Height="360" Fill="#BBDCCB" Opacity="0.42" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-160,0,0"/>
        <Ellipse Width="340" Height="340" Stroke="#CAD7D1" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,120,0"/>
        <Ellipse Width="320" Height="320" Stroke="#CAD7D1" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="100,0,0,100"/>
        <Ellipse Width="380" Height="380" Fill="#D9D7B8" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-180,-180"/>

        <!-- Main Card -->
        <Border Width="460" Style="{StaticResource GlassCard}" CornerRadius="24" Background="White" BorderThickness="0" Padding="36,28" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <!-- Brand Logo -->
                <Image Source="pack://application:,,,/Assets/Brand/CraftConnectLogo.png"
                       Width="60" Height="60" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- Headers -->
                <TextBlock Text="Create account" FontFamily="{StaticResource SerifFont}" Foreground="{StaticResource DeepGreenBrush}"
                           FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Set up access for a new team member" Style="{StaticResource MutedText}"
                           FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <!-- Tab Switcher -->
                <Border BorderBrush="#CAD7D1" BorderThickness="1" CornerRadius="22" Padding="3" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Inactive Login Tab Button -->
                        <Button Grid.Column="0" Content="Login" Command="{Binding ShowLoginCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryGreenBrush}" 
                                FontWeight="SemiBold" FontSize="14" Cursor="Hand" Padding="0,10">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Active Sign Up Tab -->
                        <Border Grid.Column="1" Background="{StaticResource PrimaryGreenBrush}" CornerRadius="18" Padding="0,10">
                            <TextBlock Text="Sign up" Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Input Fields -->
                <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#33464D" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="newuser" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,12"/>

                <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#33464D" FontSize="12" Margin="0,0,0,4"/>
                <PasswordBox Password="demo123" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,12"/>

                <TextBlock Text="Reconfirm password" FontWeight="SemiBold" Foreground="#33464D" FontSize="12" Margin="0,0,0,4"/>
                <PasswordBox Password="demo123" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,18"/>

                <!-- Actions -->
                <Button Content="Create account" Command="{Binding CreateAccountCommand}" Style="{StaticResource PrimaryButton}" Padding="16,12" Margin="0,0,0,10"/>
                <Button Content="Already have an account? Sign in" Command="{Binding ShowLoginCommand}" Style="{StaticResource SecondaryButton}" Padding="16,12"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
