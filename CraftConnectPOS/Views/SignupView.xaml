<UserControl x:Class="CraftConnectPOS.Views.SignupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:CraftConnectPOS.Behaviors">
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Background Shapes matching v19 mockup -->
        <Ellipse Width="360" Height="360" Fill="#BBDCCB" Opacity="0.42" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-160,0,0"/>
        <Ellipse Width="340" Height="340" Stroke="#CAD7D1" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,120,0"/>
        <Ellipse Width="320" Height="320" Stroke="#CAD7D1" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="100,0,0,100"/>
        <Ellipse Width="380" Height="380" Fill="#D9D7B8" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-180,-180"/>

        <!-- Main Card -->
        <Border Width="460" Style="{StaticResource GlassCard}" CornerRadius="24" Background="White" BorderThickness="0" Padding="36,28" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <!-- Brand Logo -->
                <Image Source="pack://application:,,,/Assets/Brand/CraftConnectLogo.png"
                       Width="60" Height="60" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- Headers -->
                <TextBlock Text="Create account" FontFamily="{StaticResource SerifFont}" Foreground="{StaticResource DeepGreenBrush}"
                           FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Set up access for a new team member" Style="{StaticResource MutedText}"
                           FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <!-- Loading Progress Bar -->
                <ProgressBar Height="3" IsIndeterminate="True" BorderThickness="0" Background="Transparent" 
                             Foreground="{StaticResource PrimaryGreenBrush}" Margin="0,0,0,14">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!-- Tab Switcher -->
                <Border BorderBrush="#CAD7D1" BorderThickness="1" CornerRadius="22" Padding="3" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Inactive Login Tab Button -->
                        <Button Grid.Column="0" Content="Login" Command="{Binding ShowLoginCommand}" TabIndex="7"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryGreenBrush}" 
                                FontWeight="SemiBold" FontSize="14" Cursor="Hand" Padding="0,10">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Active Sign Up Tab -->
                        <Border Grid.Column="1" Background="{StaticResource PrimaryGreenBrush}" CornerRadius="18" Padding="0,10">
                            <TextBlock Text="Sign up" Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Input Fields -->
                <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#33464D" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Username"
                         TabIndex="1" Margin="0,0,0,12">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding CreateAccountCommand}"/>
                    </TextBox.InputBindings>
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource InputBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#33464D" FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <!-- PasswordBox (Hidden when Show Password is true) -->
                    <PasswordBox x:Name="pwdBox" TabIndex="2"
                                 AutomationProperties.Name="Password"
                                 behaviors:PasswordBoxAssistant.BindPassword="True"
                                 behaviors:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CreateAccountCommand}"/>
                        </PasswordBox.InputBindings>
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox" BasedOn="{StaticResource InputPassword}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>
                    <!-- TextBox (Visible when Show Password is true) -->
                    <TextBox Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Password"
                             TabIndex="2">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CreateAccountCommand}"/>
                        </TextBox.InputBindings>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource InputBox}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <TextBlock Text="Reconfirm password" FontWeight="SemiBold" Foreground="#33464D" FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <!-- PasswordBox (Hidden when Show Password is true) -->
                    <PasswordBox x:Name="confirmPwdBox" TabIndex="3"
                                 AutomationProperties.Name="Reconfirm password"
                                 behaviors:PasswordBoxAssistant.BindPassword="True"
                                 behaviors:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CreateAccountCommand}"/>
                        </PasswordBox.InputBindings>
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox" BasedOn="{StaticResource InputPassword}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>
                    <!-- TextBox (Visible when Show Password is true) -->
                    <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Reconfirm password"
                             TabIndex="3">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CreateAccountCommand}"/>
                        </TextBox.InputBindings>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource InputBox}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- Options -->
                <Grid Margin="0,0,0,18">
                    <CheckBox Content="Show password" IsChecked="{Binding IsPasswordVisible, Mode=TwoWay}" Foreground="#33464D" TabIndex="4" VerticalAlignment="Center">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </Grid>

                <!-- Error Message Display -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"
                           AutomationProperties.LiveSetting="Assertive"
                           FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Actions -->
                <Button Command="{Binding CreateAccountCommand}" TabIndex="5" Margin="0,0,0,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Create account"/>
                            <Setter Property="Padding" Value="16,12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Content" Value="Creating account..."/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Already have an account? Sign in" Command="{Binding ShowLoginCommand}" TabIndex="6" Padding="16,12">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
