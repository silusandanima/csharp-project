<UserControl x:Class="CraftConnectPOS.Views.ProductManagementView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CraftConnectPOS.Controls">
    <UserControl.Resources>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Metric Cards -->
        <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:MetricCard Margin="0,0,12,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.65*"/>
            </Grid.ColumnDefinitions>

            
            <Border Style="{StaticResource GlassCard}" Margin="0,0,18,0">
                <StackPanel>
                    
                    <Border CornerRadius="8,8,0,0" Height="5" Margin="-22,-22,-22,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource DeepGreenColor}" Offset="0"/>
                                <GradientStop Color="{StaticResource PrimaryGreenColor}" Offset="0.6"/>
                                <GradientStop Color="#CBE4D6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <TextBlock Text="Product Details" FontFamily="{StaticResource SerifFont}" FontSize="22"
                               Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold" Margin="0,0,0,18"/>

                    
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="M20,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6A2,2 0 0,0 20,4M20,11H13V6H20V11Z"
                              Fill="{StaticResource MutedTextBrush}" Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="Code" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Product code"
                             Style="{StaticResource InputBox}" Margin="0,4,0,12"/>

                    
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,7V13L15.25,15.58L16,14.33L12.5,12.25V7H11Z"
                              Fill="{StaticResource MutedTextBrush}" Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Product name"
                             Style="{StaticResource InputBox}" Margin="0,4,0,12"/>

                    
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                              Fill="{StaticResource MutedTextBrush}" Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="Category" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Product category"
                             Style="{StaticResource InputBox}" Margin="0,4,0,12"/>

                    
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"
                              Fill="{StaticResource MutedTextBrush}" Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="Price" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Product price"
                             Style="{StaticResource InputBox}" Margin="0,4,0,12"/>

                    
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.37L12.57,21.37C12.37,21.47 12.16,21.5 11.97,21.5C11.78,21.5 11.57,21.47 11.37,21.37L3.47,17.37C3.15,17.21 2.94,16.88 2.94,16.5V7.5C2.94,7.12 3.15,6.79 3.47,6.63L11.37,2.63C11.75,2.44 12.19,2.44 12.57,2.63L20.47,6.63C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L5.04,7.5L12,10.85L18.96,7.5L12,4.15M4.94,15.55L11,18.58V12L4.94,9V15.55M19.06,15.55V9L13,12V18.58L19.06,15.55Z"
                              Fill="{StaticResource MutedTextBrush}" Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="Stock" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBox Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Product stock"
                             Style="{StaticResource InputBox}" Margin="0,4,0,12"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               AutomationProperties.LiveSetting="Assertive"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Save" Command="{Binding SaveProductCommand}"
                                AutomationProperties.Name="Save product"
                                Style="{StaticResource PrimaryButton}"
                                Height="42" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Delete" Command="{Binding DeleteProductCommand}"
                                Style="{StaticResource DangerButton}" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            
            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                <DockPanel>
                    
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Catalogue" FontFamily="{StaticResource SerifFont}" FontSize="22"
                                       Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold"/>
                            <TextBlock Text="All registered products" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="+ Add New" Command="{Binding AddNewCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="14,7"
                                HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    
                    <Border DockPanel.Dock="Top" Height="38" Background="White"
                            BorderBrush="#CAD7D1" BorderThickness="1" CornerRadius="19"
                            Margin="0,0,0,16" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                                  Fill="{StaticResource MutedTextBrush}" Width="16" Height="16"
                                  Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,8,0"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Search catalogue"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Foreground="{StaticResource DeepGreenBrush}" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="Search catalogue..." Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    
                    <DataGrid ItemsSource="{Binding ProductsView}"
                              SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              RowHeight="48"
                              ColumnHeaderHeight="46"
                              RowStyle="{StaticResource OwnedDataGridRow}"
                              CellStyle="{StaticResource OwnedDataGridCell}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF4EE"
                              HorizontalScrollBarVisibility="Auto"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#FAFDFB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="70"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="140"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>

                            
                            <DataGridTemplateColumn Header="Stock" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Stock}" Value="Low Stock">
                                                            <Setter Property="Background" Value="#FFF3E0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Stock}" Value="Out of Stock">
                                                            <Setter Property="Background" Value="#FFEBEE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Stock}" FontWeight="SemiBold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Stock}" Value="Low Stock">
                                                                <Setter Property="Foreground" Value="#EF6C00"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Stock}" Value="Out of Stock">
                                                                <Setter Property="Foreground" Value="#D32F2F"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="85"/>

                           
                            <DataGridTemplateColumn Header="Actions" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            
                                            <Button Command="{Binding DataContext.EditProductCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="Edit product"
                                                    Padding="0" Margin="0,0,8,0" ToolTip="Edit Product">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Width" Value="28"/>
                                                        <Setter Property="Height" Value="28"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="14">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBorder" Property="Background" Value="#EAF4EE"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.07,6.19L3,17.25Z"
                                                      Fill="#1E88E5" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                            
                                            <Button Command="{Binding DataContext.DeleteProductCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="Delete product"
                                                    Padding="0" ToolTip="Delete Product">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Width" Value="28"/>
                                                        <Setter Property="Height" Value="28"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="14">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBorder" Property="Background" Value="#FFEBEE"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                                <Path Data="M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z"
                                                      Fill="#D32F2F" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>

