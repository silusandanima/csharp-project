<UserControl x:Class="CraftConnectPOS.Views.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CraftConnectPOS.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:MetricCard Margin="0,0,12,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.65*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="Product Details" FontFamily="{StaticResource SerifFont}" FontSize="22"
                               Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold" Margin="0,0,0,18"/>
                    <TextBlock Text="Code" FontWeight="SemiBold"/>
                    <TextBox Text="CR-104" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Name" FontWeight="SemiBold"/>
                    <TextBox Text="Handwoven reed basket" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Category" FontWeight="SemiBold"/>
                    <TextBox Text="Home decor" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Price" FontWeight="SemiBold"/>
                    <TextBox Text="Rs. 2,450" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Stock" FontWeight="SemiBold"/>
                    <TextBox Text="42 units" Style="{StaticResource InputBox}" Margin="0,5,0,18"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Save Product" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Delete" Style="{StaticResource DangerButton}" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="Catalogue" FontFamily="{StaticResource SerifFont}" FontSize="22"
                                   Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold"/>
                        <Button Content="Add New" Style="{StaticResource PrimaryButton}" Padding="14,7"
                                HorizontalAlignment="Right"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="100"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

