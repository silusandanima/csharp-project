<UserControl x:Class="CraftConnectPOS.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:CraftConnectPOS.Behaviors">
    <UserControl.Resources>
        <Style x:Key="RoundedTextBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DeepGreenBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding HasError}" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource InputPassword}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DeepGreenBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding HasError}" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Background Shapes matching v19 mockup -->
        <Ellipse Width="360" Height="360" Fill="#BBDCCB" Opacity="0.42" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-160,0,0"/>
        <Ellipse Width="340" Height="340" Stroke="#CAD7D1" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,120,0"/>
        <Ellipse Width="320" Height="320" Stroke="#CAD7D1" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="100,0,0,100"/>
        <Ellipse Width="380" Height="380" Fill="#D9D7B8" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-180,-180"/>

        <!-- Main Card -->
        <Border Width="460" Style="{StaticResource GlassCard}" CornerRadius="24" Background="White" BorderThickness="0" Padding="36,28" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <!-- Brand Logo -->
                <Image Source="pack://application:,,,/Assets/Brand/CraftConnectLogo.png"
                       Width="60" Height="60" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- Headers -->
                <TextBlock Text="Welcome back" FontFamily="{StaticResource SerifFont}" Foreground="{StaticResource DeepGreenBrush}"
                           FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Sign in to manage your craft business" Style="{StaticResource MutedText}"
                           FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <!-- Loading Progress Bar -->
                <ProgressBar Height="3" IsIndeterminate="True" BorderThickness="0" Background="Transparent" 
                             Foreground="{StaticResource PrimaryGreenBrush}" Margin="0,0,0,14">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!-- Tab Switcher -->
                <Border BorderBrush="#CAD7D1" BorderThickness="1" CornerRadius="22" Padding="3" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Active Login Tab -->
                        <Border Grid.Column="0" Background="{StaticResource PrimaryGreenBrush}" CornerRadius="18" Padding="0,10">
                            <TextBlock Text="Login" Foreground="White" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                        </Border>
                        <!-- Inactive Sign Up Tab Button -->
                        <Button Grid.Column="1" Content="Sign up" Command="{Binding ShowSignupCommand}" TabIndex="7"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryGreenBrush}" 
                                FontWeight="SemiBold" FontSize="14" Cursor="Hand" Padding="0,10">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Input Fields -->
                <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#33464D" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="1" Margin="0,0,0,12">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SignInCommand}"/>
                    </TextBox.InputBindings>
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#33464D" FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <!-- PasswordBox (Hidden when Show Password is true) -->
                    <PasswordBox x:Name="pwdBox" TabIndex="2"
                                 behaviors:PasswordBoxAssistant.BindPassword="True"
                                 behaviors:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SignInCommand}"/>
                        </PasswordBox.InputBindings>
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox" BasedOn="{StaticResource RoundedPasswordBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>
                    <!-- TextBox (Visible when Show Password is true) -->
                    <TextBox Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="2">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SignInCommand}"/>
                        </TextBox.InputBindings>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- Options -->
                <Grid Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Remember me" IsChecked="True" Foreground="#33464D" TabIndex="3" Margin="0,0,12,0">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <CheckBox Content="Show password" IsChecked="{Binding IsPasswordVisible, Mode=TwoWay}" Foreground="#33464D" TabIndex="4">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </StackPanel>
                    <TextBlock Text="Forgot password?" Foreground="{StaticResource PrimaryGreenBrush}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                </Grid>

                <!-- Error Message Display -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"
                           FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Actions -->
                <Button Command="{Binding SignInCommand}" TabIndex="5" Margin="0,0,0,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Sign in"/>
                            <Setter Property="Padding" Value="16,12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Content" Value="Signing in..."/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="New user? Create account" Command="{Binding ShowSignupCommand}" TabIndex="6" Padding="16,12">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
