<UserControl x:Class="CraftConnectPOS.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CraftConnectPOS.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:MetricCard Margin="0,0,12,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.65*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource GlassCard}" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="Supplier Details" FontFamily="{StaticResource SerifFont}" FontSize="22"
                               Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold" Margin="0,0,0,18"/>
                    <TextBlock Text="Supplier name" FontWeight="SemiBold"/>
                    <TextBox Text="Dumbara Weavers" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Phone" FontWeight="SemiBold"/>
                    <TextBox Text="077-8927543" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Location" FontWeight="SemiBold"/>
                    <TextBox Text="Kandy" Style="{StaticResource InputBox}" Margin="0,5,0,12"/>
                    <TextBlock Text="Materials supplied" FontWeight="SemiBold"/>
                    <TextBox Text="Reed fiber, cotton thread" Style="{StaticResource InputBox}" Height="78"
                             TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5,0,18"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Save Changes" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Delete" Style="{StaticResource DangerButton}" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Suppliers List" FontFamily="{StaticResource SerifFont}" FontSize="22"
                               Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold" Margin="0,0,0,16"/>
                    <DataGrid ItemsSource="{Binding Suppliers}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="120"/>
                            <DataGridTextColumn Header="Materials Supplied" Binding="{Binding Materials}" Width="230"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

