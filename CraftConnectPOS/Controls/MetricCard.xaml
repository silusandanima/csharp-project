<UserControl x:Class="CraftConnectPOS.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="92">
    <Border Style="{StaticResource GlassCard}" Padding="18">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Value}" Foreground="{StaticResource DeepGreenBrush}" FontFamily="{StaticResource SerifFont}"
                       FontSize="29" FontWeight="Bold" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Note}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</UserControl>

