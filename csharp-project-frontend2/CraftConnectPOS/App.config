<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="CraftConnectDatabase"
			 connectionString="Server=(localdb)\MSSQLLocalDB;Database=ArtisanCraftDB;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=5;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>