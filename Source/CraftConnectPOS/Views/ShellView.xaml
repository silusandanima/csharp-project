<UserControl x:Class="CraftConnectPOS.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Ellipse Width="360" Height="360" Fill="#DCECE3" Opacity="0.45" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-205,-130,0,0"/>
        <Ellipse Width="420" Height="420" Stroke="#DCD9BB" StrokeThickness="45" Opacity="0.33" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-210,-260"/>

        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" CornerRadius="22" Padding="24">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,28" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/Brand/CraftConnectLogo.png"
                                   Width="34" Height="34" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="CraftConnect" 
                                       Foreground="{StaticResource DeepGreenBrush}" 
                                       FontFamily="{StaticResource SerifFont}"
                                       FontSize="22" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center" 
                                       Margin="12,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="MODULES" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Button Content="Dashboard" Command="{Binding ShowDashboardCommand}" Tag="{Binding IsDashboardSelected}" Style="{StaticResource NavButton}" Margin="0,0,0,6"/>
                        <Button Content="Products" Command="{Binding ShowProductsCommand}" Tag="{Binding IsProductsSelected}" Style="{StaticResource NavButton}" Margin="0,0,0,6"/>
                        <Button Content="Inventory" Command="{Binding ShowInventoryCommand}" Tag="{Binding IsInventorySelected}" Style="{StaticResource NavButton}" Margin="0,0,0,6"/>
                        <Button Content="Suppliers" Command="{Binding ShowSuppliersCommand}" Tag="{Binding IsSuppliersSelected}" Style="{StaticResource NavButton}" Margin="0,0,0,6"/>
                        <Button Content="Orders" Command="{Binding ShowOrdersCommand}" Tag="{Binding IsOrdersSelected}" Style="{StaticResource NavButton}" Margin="0,0,0,6"/>
                        <Button Content="Statistics" Command="{Binding ShowStatisticsCommand}" Tag="{Binding IsStatisticsSelected}" Style="{StaticResource NavButton}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <Border Background="#E9F7EE" CornerRadius="10" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" Background="{StaticResource DeepGreenBrush}" CornerRadius="17">
                                    <TextBlock Text="{Binding CurrentUserInitial}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="{Binding CurrentUsername}" Foreground="{StaticResource DeepGreenBrush}" FontWeight="Bold"/>
                                    <TextBlock Text="Business Owner" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Content="Log out" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="0,12,0,0" Padding="14,9"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="28,8,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="82"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Width="300" Height="42" Background="#FAFEFB" BorderBrush="#C7D8D0" BorderThickness="1"
                            CornerRadius="21" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Grid>
                            <TextBlock Text="Search..." Foreground="{StaticResource MutedTextBrush}" Margin="22,0,0,0" VerticalAlignment="Center"/>
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource PrimaryGreenBrush}"
                                    HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="15" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
